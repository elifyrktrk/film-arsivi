# Copy to .env (never commit .env). All values are optional.

# TMDB v3 API key or v4 read access token (starts with "eyJ").
# Without it the site searches anime only (AniList needs no key).
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Listen address (default 0.0.0.0:8080: reachable from phones on the same Wi-Fi).
# Use 127.0.0.1:8080 to keep it on this Mac only. PORT alone also works.
# ADDR=0.0.0.0:8080

# SQLite file (default data/film-arsivi.db)
# DB_PATH=data/film-arsivi.db

# debug | info | warn | error
# LOG_LEVEL=info
