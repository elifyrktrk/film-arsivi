# Copy to .env (never commit .env). All values are optional.

# TMDB v3 API key or v4 read access token (starts with "eyJ").
# Without it the site searches anime only (AniList needs no key).
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Listen address (default 0.0.0.0:8090: reachable from phones on the same Wi-Fi).
# Use 127.0.0.1:8090 to keep it on this Mac only. PORT alone also works.
# ADDR=0.0.0.0:8090

# SQLite file (default data/film-arsivi.db)
# DB_PATH=data/film-arsivi.db

# debug | info | warn | error
# LOG_LEVEL=info

# IMDb ratings (~8 MB, daily) are downloaded only when TMDB_API_KEY is set.
# Set to "off" to skip the download.
# IMDB_SYNC=on

# ---- Google sign-in (optional) ----
# Leave both empty to run single-user without sign-in (the app keeps working).
# Create them in Google Cloud Console (see README: "Google OAuth istemcisi oluşturma").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address of the site; the redirect URI is BASE_URL + /auth/google/callback.
# Google accepts http://localhost or an HTTPS domain, NOT a LAN IP like 192.168.x.x.
BASE_URL=http://localhost:8090

# Comma-separated invite list. Empty = any Google account can sign in.
ALLOWED_EMAILS=

# Gets the ratings and categories created before sign-in was turned on (first login).
OWNER_EMAIL=
